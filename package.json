{
  "name": "pocketrpg",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:app": "vite build --config vite.config.app.js",
    "prebuild": "npm test",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "build:css": "tailwindcss -i ./src/index.css -o ./.tmp/app.css --minify",
    "rebuild": "tsc --project tsconfig.build.json && node build_single.cjs",
    "check:single": "node scripts/check-single-file-build.cjs",
    "seed:bots": "node scripts/seed-pvp-bots.cjs",
    "gen:knowledge": "node scripts/gen-chat-knowledge.cjs",
    "gen:model": "node scripts/process-3d-model.mjs",
    "sync:three": "node scripts/sync-three-vendor.mjs",
    "claude:headroom": "bash scripts/headroom-claude.sh",
    "ci": "npm run build && npm run rebuild && npm run check:single",
    "world:check": "cd world && npm run typecheck && npm test && npm run build",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.0",
    "@capacitor/browser": "^8.0.3",
    "@capacitor/core": "^8.3.4",
    "@capacitor/network": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "@fontsource/cinzel": "^5.2.8",
    "@fontsource/grenze-gotisch": "^5.2.8",
    "@fontsource/im-fell-english": "^5.2.6",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fontsource/nunito": "^5.2.7",
    "@fontsource/spectral": "^5.2.8",
    "@fontsource/spline-sans-mono": "^5.2.8",
    "idb": "^8.0.2",
    "preact": "^10.25.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.3.4",
    "@capacitor/ios": "^8.3.4",
    "@gltf-transform/core": "^4.4.1",
    "@gltf-transform/extensions": "^4.4.1",
    "@gltf-transform/functions": "^4.4.1",
    "@iconify-json/game-icons": "^1.2.4",
    "@preact/preset-vite": "^2.9.4",
    "@tailwindcss/cli": "^4.1.3",
    "@tailwindcss/vite": "^4.1.3",
    "@types/node": "^25.6.0",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.4",
    "gh-pages": "^6.3.0",
    "meshoptimizer": "^1.2.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.1.3",
    "three": "0.185.1",
    "typescript": "^6.0.2",
    "vite": "^6.3.1",
    "vitest": "^4.1.4"
  }
}
