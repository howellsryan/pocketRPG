# Allow indexing on the production custom domain. NOTE: Cloudflare Pages
# injects `x-robots-tag: noindex` on *.pages.dev preview/alias deployments at
# the edge and that cannot be overridden from _headers — so the SEO audit will
# still report "blocked from indexing" when run against a *.pages.dev URL.
# Run Lighthouse against the production domain (pocketrpg.co.uk) to verify.
/*
  X-Robots-Tag: index, follow
  Content-Security-Policy: frame-ancestors *
  Cross-Origin-Resource-Policy: cross-origin

# Long-lived caching for static, content-stable assets (fonts + landing
# screenshots). These are served from /public by Cloudflare Pages.
/public/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/public/landing/*
  Cache-Control: public, max-age=31536000, immutable

# Vendored three.js + 3D model assets — fetched lazily only when a 3D view
# mounts. NOT immutable: these filenames are stable while their content can
# change in place (three upgrades via sync:three, model re-exports like the
# rigged-warrior swap), and the ES-module graph must never mix cached-old and
# new files. Hourly revalidation is a cheap 304 via ETag when unchanged.
/public/vendor/*
  Cache-Control: public, max-age=3600, must-revalidate

/public/3d-samples/*
  Cache-Control: public, max-age=3600, must-revalidate

# The lazily-loaded in-game code chunk is content-hashed (game-<hash>.js), so a
# new deploy ships a new filename — safe to cache immutably.
/game-*.js
  Cache-Control: public, max-age=31536000, immutable
