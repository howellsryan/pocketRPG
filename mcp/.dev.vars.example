# Copy to .dev.vars for `wrangler dev`. In production set these with
# `wrangler secret put <NAME>` (NOT committed). See README.md.

# MUST be byte-identical to the Pages project's JWT_SECRET so the session
# tokens the MCP worker mints verify against the shared logic.
JWT_SECRET=

# OAuth app credentials. Can be your existing PocketRPG apps (if their callback
# URL can be pointed at the MCP host) or a dedicated MCP OAuth app — either way
# they resolve to the same account because identity is keyed on the provider's
# stable user id. See README "OAuth app setup".
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
