{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pocketrpg-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-01",
  // nodejs_compat: the bundled game handlers + JSON content imports rely on it.
  "compatibility_flags": ["nodejs_compat"],

  // SHARED with the main Pages project. Same database_id as the root
  // wrangler.toml [[d1_databases]] block — the MCP worker reads/writes the
  // exact same characters / saves / oauth_identities rows.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pocketrpg",
      "database_id": "439e810b-8dce-4697-94c2-a7392520ad8f"
    }
  ],

  // workers-oauth-provider stores authorization grants / tokens here.
  // Create with: wrangler kv namespace create OAUTH_KV  (see README).
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "REPLACE_WITH_KV_NAMESPACE_ID"
    }
  ],

  // McpAgent persists per-session MCP transport state in a SQLite-backed
  // Durable Object.
  "durable_objects": {
    "bindings": [{ "class_name": "PocketRpgMCP", "name": "MCP_OBJECT" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PocketRpgMCP"] }],

  "vars": {
    "APP_BASE_URL": "https://pocketrpg.co.uk"
  },

  "observability": { "enabled": true }

  // Secrets (set via `wrangler secret put <NAME>` — see README):
  //   JWT_SECRET             — MUST be byte-identical to the Pages project's
  //                            JWT_SECRET so minted session tokens verify.
  //   GITHUB_CLIENT_ID       — GitHub OAuth app (see README on which app).
  //   GITHUB_CLIENT_SECRET
  //   GOOGLE_CLIENT_ID       — Google OAuth 2.0 client.
  //   GOOGLE_CLIENT_SECRET
}
