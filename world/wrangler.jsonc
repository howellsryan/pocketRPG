{
  "name": "pocketrpg-world",
  "main": "server/index.ts",
  "compatibility_date": "2026-07-01",
  // Production (top-level, deployed by plain `wrangler deploy`). `exports`
  // (the Durable Object class lifecycle) is inheritable, so env.preview picks
  // it up — declare it once here, never per environment.
  // workers_dev explicitly off: production is reached only via the
  // world.pocketrpg.co.uk custom domain (Cloudflare's own recommendation),
  // not the workers.dev URL — that's env.preview's job below. Explicit
  // rather than relying on wrangler's default, which has changed before.
  "workers_dev": false,
  "assets": { "directory": "client/dist", "binding": "ASSETS" },
  // CoopBossRoom is hosted here but never routed here: the Pages app binds it
  // cross-script (see the root wrangler.toml). Pages projects cannot export
  // Durable Object classes, and this Worker already has the DO runtime and the
  // same D1 database the co-op tables live in.
  "durable_objects": {
    "bindings": [
      { "name": "WorldZone", "class_name": "WorldZone" },
      { "name": "CoopBossRoom", "class_name": "CoopBossRoom" }
    ]
  },
  // Declarative DO lifecycle — mutually exclusive with the legacy `migrations`
  // tag chain it replaced, and never to be reverted to it: Cloudflare
  // reconciles this against the namespaces already provisioned, so an existing
  // class is a no-op, where the tag chain resent `new_sqlite_classes` from v1
  // whenever the deployed script reported no migration tag (error 10074).
  // `storage` is immutable — it must keep matching the backend that created it.
  "exports": {
    "WorldZone": { "type": "durable-object", "storage": "sqlite" },
    "CoopBossRoom": { "type": "durable-object", "storage": "sqlite" }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pocketrpg",
      "database_id": "439e810b-8dce-4697-94c2-a7392520ad8f",
      "migrations_dir": "../migrations"
    }
  ],
  // Preview environment, deployed with `wrangler deploy --env preview` (its
  // own Worker service, `pocketrpg-world-preview`, with its own workers.dev
  // URL — Cloudflare does not auto-suffix custom domains, only the default
  // workers.dev one). Bindings (assets/durable_objects/d1_databases) are
  // NOT inherited from the top level in wrangler — every binding must be
  // redeclared here even though only the D1 target actually differs.
  "env": {
    "preview": {
      "workers_dev": true,
      // Preview-ONLY quest-gate bypass. Never add this to the top-level
      // (production) config — see src/engine/questGates.js.
      "vars": { "DISABLE_QUEST_REQUIREMENTS": "true" },
      "assets": { "directory": "client/dist", "binding": "ASSETS" },
      "durable_objects": {
        "bindings": [
          { "name": "WorldZone", "class_name": "WorldZone" },
          { "name": "CoopBossRoom", "class_name": "CoopBossRoom" }
        ]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "pocketrpg-preview",
          "database_id": "59233295-f492-4113-94da-90034d84a6a4",
          "migrations_dir": "../migrations"
        }
      ]
    }
  }
}
