{
  "name": "pocketrpg-world",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "dev:client": "vite --config client/vite.config.ts",
    "dev:seed": "node scripts/dev-seed.mjs",
    "build": "vite build --config client/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "partyserver": "0.5.8",
    "partysocket": "1.3.0",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260702.1",
    "@types/node": "^25.6.0",
    "@types/three": "0.185.1",
    "typescript": "^6.0.2",
    "vite": "^6.3.1",
    "vitest": "^4.1.4",
    "wrangler": "4.107.1"
  }
}
