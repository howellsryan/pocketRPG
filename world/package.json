{
  "name": "pocketrpg-world",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev:client": "node scripts/gen-prop-manifest.mjs && vite --config client/vite.config.ts",
    "dev:seed": "node scripts/dev-seed.mjs",
    "gen:props": "node scripts/gen-prop-manifest.mjs",
    "build": "node scripts/gen-prop-manifest.mjs && vite build --config client/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "ci": "npm run typecheck && npm run test && npm run build",
    "shoot:zones": "node scripts/shoot-zone.mjs",
    "author:build": "node scripts/compile-world.mjs lumbright",
    "author:check": "node scripts/compile-world.mjs lumbright --check",
    "author:release": "node scripts/compile-world.mjs lumbright --check --release",
    "author:review": "node scripts/review-authoring.mjs lumbright"
  },
  "dependencies": {
    "partyserver": "0.5.8",
    "partysocket": "1.3.0",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260702.1",
    "@gltf-transform/core": "^4.4.1",
    "@gltf-transform/extensions": "^4.4.1",
    "@gltf-transform/functions": "^4.4.1",
    "@types/node": "^25.6.0",
    "@types/three": "0.185.1",
    "meshoptimizer": "^1.2.0",
    "playwright": "^1.56.1",
    "sharp": "^0.35.3",
    "typescript": "^6.0.2",
    "vite": "^6.3.1",
    "vitest": "^4.1.4",
    "wrangler": "4.107.1"
  }
}
